{
  "expo": {
    "name": "Markaz App",
    "slug": "markaz-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/markaz-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.markazapp",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/markaz-icon.png",
      "publicPath": "/app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.anonymous.markazapp",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE"
      ],
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/markaz-icon.png",
        "backgroundColor": "#059669"
      },
      "googleServicesFile": "./google-services.json",
      "image": "ubuntu-18.04-jdk-11-ndk-r19c"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "49718800-5134-4baf-8242-2707af98fdc1"
      }
    },
    "owner": "mubashiransari"
  }
}